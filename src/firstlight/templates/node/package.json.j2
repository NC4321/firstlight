{
  "name": "{{ project_name }}",
  "version": "0.1.0",
  "description": "{{ description }}",
  {% if has_license %}
  "license": "{{ license_display }}",
  {% endif %}
  "author": "{{ author }} <{{ email }}>",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
